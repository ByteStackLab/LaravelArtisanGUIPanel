{
  "name": "laravel-artisan-toolkit",
  "displayName": "Laravel Artisan Toolkit",
  "description": "Browse, search, copy, and run Laravel Artisan commands from a sidebar panel without typing them in the terminal.",
  "version": "1.0.0",
  "publisher": "bytestacklab",
  "license": "MIT",
  "icon": "media/icon.png",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "laravel",
    "artisan",
    "toolkit",
    "php",
    "bytestacklab",
    "make:controller",
    "migration"
  ],
  "galleryBanner": {
    "color": "#0F111A",
    "theme": "dark"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ByteStackLab/LaravelArtisanToolkit"
  },
  "homepage": "https://bytestacklab.com",
  "bugs": {
    "url": "https://github.com/ByteStackLab/LaravelArtisanToolkit/issues"
  },
  "activationEvents": [
    "workspaceContains:artisan",
    "workspaceContains:*/artisan"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "laravelArtisan",
          "title": "Laravel Artisan",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "laravelArtisan": [
        {
          "type": "webview",
          "id": "laravelArtisan.panel",
          "name": "Artisan Commands"
        }
      ]
    },
    "commands": [
      {
        "command": "laravelArtisan.refresh",
        "title": "Laravel Artisan: Refresh Commands",
        "icon": "$(refresh)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "laravelArtisan.refresh",
          "when": "view == laravelArtisan.panel",
          "group": "navigation"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.9.2",
    "typescript": "^5.4.0"
  }
}
